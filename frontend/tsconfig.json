{
  "extends": "astro/tsconfigs/strict",
  "include": [
    "src/**/*",
    "scripts/**/*",
    "e2e/**/*",
    "playwright.config.ts",
    ".astro/types.d.ts"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}

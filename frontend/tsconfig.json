{
  "extends": "astro/tsconfigs/strict",
  "include": ["src/**/*", "scripts/**/*", ".astro/types.d.ts"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}

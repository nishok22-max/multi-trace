{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*$",
          "title": "Entity Id",
          "type": "string"
        },
        "features": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Features",
          "type": "object"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "vetoed": {
          "default": false,
          "title": "Vetoed",
          "type": "boolean"
        }
      },
      "required": [
        "entity_id",
        "score"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "ClaimRecord": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "title": "Attribute",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^clm_[0-9a-f]{24}$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "extracted",
            "inferred"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "created_at": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "derived_from": {
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "evidence": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "human_decision": "#/$defs/HumanDecisionPointer",
                  "image_region": "#/$defs/ImageRegionPointer",
                  "sensor_window": "#/$defs/SensorWindowPointer",
                  "table_cell": "#/$defs/TableCellPointer",
                  "text_span": "#/$defs/TextSpanPointer"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextSpanPointer"
                },
                {
                  "$ref": "#/$defs/ImageRegionPointer"
                },
                {
                  "$ref": "#/$defs/TableCellPointer"
                },
                {
                  "$ref": "#/$defs/SensorWindowPointer"
                },
                {
                  "$ref": "#/$defs/HumanDecisionPointer"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "modality": {
          "enum": [
            "text",
            "table",
            "image",
            "sensor",
            "decision"
          ],
          "title": "Modality",
          "type": "string"
        },
        "normalized_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Unit"
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Value"
        },
        "record_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Hash",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^clm_[0-9a-f]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "temporal": {
          "$ref": "#/$defs/Temporal"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "unit_status": {
          "enum": [
            "known",
            "unknown",
            "sensor_native",
            "not_applicable"
          ],
          "title": "Unit Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "value_type": {
          "enum": [
            "categorical",
            "numeric",
            "text",
            "boolean",
            "structured"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "case_id",
        "claim_type",
        "statement",
        "subject",
        "attribute",
        "value",
        "value_type",
        "unit_status",
        "temporal",
        "modality",
        "method",
        "confidence",
        "record_hash"
      ],
      "title": "ClaimRecord",
      "type": "object"
    },
    "ComparisonRecord": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/GateCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "claim_a": {
          "pattern": "^clm_[0-9a-f]{24}$",
          "title": "Claim A",
          "type": "string"
        },
        "claim_b": {
          "pattern": "^clm_[0-9a-f]{24}$",
          "title": "Claim B",
          "type": "string"
        },
        "comparison_id": {
          "pattern": "^cmp_[0-9a-f]{24}$",
          "title": "Comparison Id",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "agree",
            "disagree",
            "cant_compare",
            "cant_tell"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "comparison_id",
        "claim_a",
        "claim_b",
        "config_hash",
        "checks",
        "outcome",
        "reason"
      ],
      "title": "ComparisonRecord",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "calibrated": {
          "default": false,
          "title": "Calibrated",
          "type": "boolean"
        },
        "calibration_fit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Fit Id"
        },
        "components": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Components",
          "type": "object"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "stage": {
          "default": "pre",
          "enum": [
            "pre",
            "final"
          ],
          "title": "Stage",
          "type": "string"
        },
        "value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConflictRecord": {
      "additionalProperties": false,
      "description": "Status is derived from review events, never stored. Values are never averaged.",
      "properties": {
        "averaged": {
          "const": false,
          "default": false,
          "title": "Averaged",
          "type": "boolean"
        },
        "comparison_ids": {
          "items": {
            "pattern": "^cmp_[0-9a-f]{24}$",
            "type": "string"
          },
          "title": "Comparison Ids",
          "type": "array"
        },
        "conflict_id": {
          "pattern": "^cf_[0-9a-f]{24}$",
          "title": "Conflict Id",
          "type": "string"
        },
        "magnitude": {
          "$ref": "#/$defs/Magnitude"
        },
        "sides": {
          "items": {
            "pattern": "^clm_[0-9a-f]{24}$",
            "type": "string"
          },
          "title": "Sides",
          "type": "array"
        },
        "supporting_context": {
          "items": {
            "pattern": "^clm_[0-9a-f]{24}$",
            "type": "string"
          },
          "title": "Supporting Context",
          "type": "array"
        }
      },
      "required": [
        "conflict_id",
        "comparison_ids",
        "sides",
        "magnitude"
      ],
      "title": "ConflictRecord",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "A stored human decision. Identity fields come from the session (promise 9).",
      "properties": {
        "at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$",
          "title": "At",
          "type": "string"
        },
        "base_version": {
          "minimum": 0,
          "title": "Base Version",
          "type": "integer"
        },
        "case_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "choice": {
          "discriminator": {
            "mapping": {
              "entity": "#/$defs/EntityChoice",
              "escalate": "#/$defs/EscalateChoice",
              "explain": "#/$defs/ExplainChoice",
              "reading": "#/$defs/ReadingChoice"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/EntityChoice"
            },
            {
              "$ref": "#/$defs/ReadingChoice"
            },
            {
              "$ref": "#/$defs/ExplainChoice"
            },
            {
              "$ref": "#/$defs/EscalateChoice"
            }
          ],
          "title": "Choice"
        },
        "decision_id": {
          "pattern": "^dec_[0-9a-f]{24}$",
          "title": "Decision Id",
          "type": "string"
        },
        "display_name_snapshot": {
          "title": "Display Name Snapshot",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "reason": {
          "minLength": 15,
          "title": "Reason",
          "type": "string"
        },
        "review_id": {
          "pattern": "^rv_[0-9a-f]{24}$",
          "title": "Review Id",
          "type": "string"
        },
        "role_snapshot": {
          "enum": [
            "viewer",
            "reviewer",
            "senior_reviewer",
            "ingestor",
            "evaluator"
          ],
          "title": "Role Snapshot",
          "type": "string"
        },
        "shown_evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Shown Evidence Hash",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^dec_[0-9a-f]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        }
      },
      "required": [
        "decision_id",
        "case_id",
        "review_id",
        "principal",
        "display_name_snapshot",
        "role_snapshot",
        "choice",
        "reason",
        "base_version",
        "shown_evidence_hash",
        "at"
      ],
      "title": "Decision",
      "type": "object"
    },
    "EntityChoice": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*$",
          "title": "Entity Id",
          "type": "string"
        },
        "type": {
          "const": "entity",
          "default": "entity",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "entity_id"
      ],
      "title": "EntityChoice",
      "type": "object"
    },
    "Envelope": {
      "additionalProperties": false,
      "properties": {
        "T_star": {
          "title": "T Star",
          "type": "number"
        },
        "degenerate_channels": {
          "items": {
            "type": "string"
          },
          "title": "Degenerate Channels",
          "type": "array"
        },
        "envelope_id": {
          "pattern": "^env_[0-9a-f]{24}$",
          "title": "Envelope Id",
          "type": "string"
        },
        "granularity": {
          "const": "day",
          "default": "day",
          "title": "Granularity",
          "type": "string"
        },
        "machine": {
          "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*$",
          "title": "Machine",
          "type": "string"
        },
        "mad": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Mad",
          "type": "object"
        },
        "med": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Med",
          "type": "object"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "params": {
          "$ref": "#/$defs/EnvelopeConfig"
        },
        "partition_hashes": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Partition Hashes",
          "type": "object"
        },
        "pool_members": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*$",
            "type": "string"
          },
          "title": "Pool Members",
          "type": "array"
        },
        "pooled": {
          "enum": [
            "none",
            "t_star_model",
            "model_level"
          ],
          "title": "Pooled",
          "type": "string"
        },
        "quiet_days": {
          "items": {
            "$ref": "#/$defs/QuietDay"
          },
          "title": "Quiet Days",
          "type": "array"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        },
        "series_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Series Id",
          "type": "string"
        },
        "statistic": {
          "const": "robust_max_z",
          "default": "robust_max_z",
          "title": "Statistic",
          "type": "string"
        }
      },
      "required": [
        "envelope_id",
        "machine",
        "series_id",
        "scope",
        "quiet_days",
        "n",
        "med",
        "mad",
        "T_star",
        "pooled",
        "pool_members",
        "degenerate_channels",
        "params",
        "partition_hashes"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "EnvelopeConfig": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Alpha",
          "type": "number"
        },
        "drift_ratio": {
          "exclusiveMinimum": 0,
          "title": "Drift Ratio",
          "type": "number"
        },
        "flatline_epsilon_factor": {
          "exclusiveMinimum": 0,
          "title": "Flatline Epsilon Factor",
          "type": "number"
        },
        "flatline_min_hours": {
          "minimum": 1,
          "title": "Flatline Min Hours",
          "type": "integer"
        },
        "margin_days": {
          "minimum": 0,
          "title": "Margin Days",
          "type": "integer"
        },
        "min_quiet_days_own_scale": {
          "minimum": 1,
          "title": "Min Quiet Days Own Scale",
          "type": "integer"
        },
        "min_quiet_days_own_t_star": {
          "minimum": 1,
          "title": "Min Quiet Days Own T Star",
          "type": "integer"
        },
        "thin_history_factor": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Thin History Factor",
          "type": "number"
        },
        "training_policy": {
          "enum": [
            "all_except_case_window",
            "before_only"
          ],
          "title": "Training Policy",
          "type": "string"
        }
      },
      "required": [
        "alpha",
        "margin_days",
        "training_policy",
        "flatline_epsilon_factor",
        "flatline_min_hours",
        "min_quiet_days_own_t_star",
        "min_quiet_days_own_scale",
        "drift_ratio",
        "thin_history_factor"
      ],
      "title": "EnvelopeConfig",
      "type": "object"
    },
    "EscalateChoice": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "escalate",
          "default": "escalate",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "EscalateChoice",
      "type": "object"
    },
    "ExplainChoice": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "type": {
          "const": "explain",
          "default": "explain",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "ExplainChoice",
      "type": "object"
    },
    "GateCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "n": {
          "maximum": 6,
          "minimum": 1,
          "title": "N",
          "type": "integer"
        },
        "name": {
          "enum": [
            "same_entity",
            "same_attribute",
            "time_overlap",
            "comparable_terms",
            "data_both_sides",
            "beyond_variation"
          ],
          "title": "Name",
          "type": "string"
        },
        "pass": {
          "title": "Pass",
          "type": "boolean"
        }
      },
      "required": [
        "n",
        "name",
        "pass",
        "detail"
      ],
      "title": "GateCheck",
      "type": "object"
    },
    "HumanDecisionPointer": {
      "additionalProperties": false,
      "properties": {
        "base_version": {
          "minimum": 0,
          "title": "Base Version",
          "type": "integer"
        },
        "decision_id": {
          "pattern": "^dec_[0-9a-f]{24}$",
          "title": "Decision Id",
          "type": "string"
        },
        "display_name_snapshot": {
          "title": "Display Name Snapshot",
          "type": "string"
        },
        "kind": {
          "const": "human_decision",
          "default": "human_decision",
          "title": "Kind",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "role_snapshot": {
          "enum": [
            "viewer",
            "reviewer",
            "senior_reviewer",
            "ingestor",
            "evaluator"
          ],
          "title": "Role Snapshot",
          "type": "string"
        },
        "shown_evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Shown Evidence Hash",
          "type": "string"
        },
        "timestamp": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "principal",
        "display_name_snapshot",
        "role_snapshot",
        "reason",
        "base_version",
        "shown_evidence_hash",
        "timestamp"
      ],
      "title": "HumanDecisionPointer",
      "type": "object"
    },
    "ImageRegionPointer": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/Rect"
        },
        "coord_space": {
          "const": "oriented_px",
          "default": "oriented_px",
          "title": "Coord Space",
          "type": "string"
        },
        "crop_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Crop Sha256",
          "type": "string"
        },
        "kind": {
          "const": "image_region",
          "default": "image_region",
          "title": "Kind",
          "type": "string"
        },
        "read_text": {
          "title": "Read Text",
          "type": "string"
        },
        "reader": {
          "enum": [
            "ocr",
            "vlm"
          ],
          "title": "Reader",
          "type": "string"
        },
        "reread_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
